{
  "name": "v2er-insight",
  "version": "2.0.0",
  "description": "V2EX 用户画像深度分析工具。通过自动化抓取数据、统计解析及 AI 语言模型建模，构建多维度的用户行为与心理画像。",
  "main": "./dist/cli/index.js",
  "bin": {
    "v2er": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy:assets": "node ./scripts/copy-dist-assets.cjs",
    "build:compile": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:assets": "pnpm run copy:assets",
    "build": "pnpm run build:compile && pnpm run build:assets",
    "build:release": "pnpm run clean:dist && pnpm run build && pnpm run prune:maps",
    "prune:maps": "node ./scripts/prune-dist-maps.cjs",
    "prepack": "pnpm run build:release",
    "pack:check": "pnpm pack --dry-run --json",
    "release:check": "pnpm run check && pnpm run test && pnpm run pack:check",
    "release:build": "pnpm run build:release",
    "release:publish": "npm publish --access public",
    "start": "node dist/cli/index.js",
    "dev": "vitest",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"*.{mjs,ts}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"*.{mjs,ts}\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{ts,mjs,json,md}\"",
    "check:types": "tsc --noEmit",
    "check": "npm run check:types && npm run lint && npm run format:check",
    "ci": "npm run check && npm run test",
    "prepare": "husky"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/ia319/v2er-insight"
  },
  "homepage": "https://github.com/ia319/v2er-insight",
  "bugs": {
    "url": "https://github.com/ia319/v2er-insight/issues"
  },
  "author": "ia319",
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@types/node": "^25.0.3",
    "axios": "^1.13.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "https-proxy-agent": "^7.0.6",
    "ora": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
